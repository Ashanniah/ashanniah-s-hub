datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum AccountType {
  CASH
  BANK
  EWALLET
  CREDIT_CARD
  INVESTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Frequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

// ------------------------------------------------------
// Models
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tasks           Task[]
  notes           Note[]
  accounts        Account[]
  transactions    Transaction[]
  exerciseLogs    ExerciseLog[]
  dailyHealthLogs DailyHealthLog[]
  foodLogs        FoodLog[]

  @@map("users")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  frequency   Frequency @default(ONCE)
  priority    Priority  @default(MEDIUM)
  category    String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, dueDate])
  @@map("tasks")
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  title     String
  content   String    @db.Text
  date      DateTime? // Optional link to specific calendar date
  isGeneral Boolean   @default(false)
  tags      String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("notes")
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  initialBalance Decimal     @default(0.00) @db.Decimal(12, 2)
  currency       String      @default("USD")
  accountNumber  String?
  color          String?     @default("#6366f1")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ledger transactions linked to this account
  outgoingTransactions Transaction[] @relation("FromAccount")
  incomingTransactions Transaction[] @relation("ToAccount")

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  category      String
  description   String?
  date          DateTime        @default(now())

  // Primary account involved in transaction
  accountId     String
  account       Account         @relation("FromAccount", fields: [accountId], references: [id], onDelete: Cascade)

  // Target account for transfers (null for Income/Expense)
  toAccountId   String?
  toAccount     Account?        @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([accountId])
  @@index([toAccountId])
  @@map("transactions")
}

model DailyHealthLog {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date // Formatted YYYY-MM-DD (unique per user per day)
  calorieGoal  Int      @default(2000)
  waterGoalMl  Int      @default(2500)
  waterIntake  Int      @default(0)
  weightKg     Decimal? @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]
  foodLogs     FoodLog[]

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_health_logs")
}

model FoodLog {
  id               String   @id @default(cuid())
  userId           String
  dailyHealthLogId String?
  foodItem         String
  calories         Int
  proteinG         Decimal  @default(0.0) @db.Decimal(5, 1)
  carbsG           Decimal  @default(0.0) @db.Decimal(5, 1)
  fatG             Decimal  @default(0.0) @db.Decimal(5, 1)
  imageUrl         String?
  loggedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyHealthLog DailyHealthLog? @relation(fields: [dailyHealthLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dailyHealthLogId])
  @@map("food_logs")
}

model ExerciseLog {
  id               String   @id @default(cuid())
  userId           String
  dailyHealthLogId String?
  activityType     String
  durationMinutes  Int
  caloriesBurned   Int
  loggedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyHealthLog DailyHealthLog? @relation(fields: [dailyHealthLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dailyHealthLogId])
  @@map("exercise_logs")
}
